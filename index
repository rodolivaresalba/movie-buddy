:var(--accent)}.result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.film{min-width:0}.poster{position:relative;aspect-ratio:4/4.5;background:var(--film-bg);border-radius:11px;padding:18px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.poster:before{content:'';position:absolute;inset:0;background:linear-gradient(transparent 25%,#0009)}.poster-num,.poster-title{z-index:1;position:relative}.poster-num{font-size:11px;letter-spacing:.12em}.poster-title{font-size:clamp(25px,3vw,36px);font-weight:700;letter-spacing:-.05em;line-height:1.1;text-wrap:balance}.film-details{padding-top:15px}.film-eyebrow{font-size:11px;letter-spacing:.08em;font-weight:700;color:var(--accent);margin-bottom:9px}.film-title{font-size:18px;font-weight:700;margin-bottom:5px}.film-meta{font-size:12px;color:var(--muted)}.film-description{font-size:13px;line-height:1.6;color:#c6c3c6;margin-top:12px}.control-panel{margin-top:58px;border:1px solid var(--border);background:var(--card);border-radius:12px;padding:24px}.control-header{display:flex;justify-content:space-between;gap:15px}.control-header h3{margin:0 0 7px;font-size:19px;letter-spacing:-.02em}.control-sub{margin:0;color:var(--muted);font-size:13px}.control-value{font-size:24px;font-weight:700;color:var(--accent)}.range{width:100%;accent-color:var(--accent);margin:26px 0 9px}.range-ends{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.range-explain{margin:14px 0 0;color:var(--accent);font-size:13px}.temperature-panel{margin-top:58px}.temp-notice{font-size:12px;color:var(--muted);line-height:1.5;margin:14px 0 0}.results-actions{display:flex;justify-content:center;margin-top:28px}.proto-note{text-align:center;color:#88868b;font-size:11px;line-height:1.5;margin:25px auto}.serif{font-family:inherit;font-weight:700}
