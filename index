
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>movie buddy — Find your movie</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #111214;
      --card: #1d1e21;
      --border: #393a3e;
      --text: #f5f4f0;
      --muted: #aaa9ac;
      --accent: #e6bd92;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "DM Sans", sans-serif;
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    button:focus-visible, input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .shell { max-width: 990px; padding: 0 26px; margin: auto; }
    header, footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    header { height: 76px; border-bottom: 1px solid var(--border); }
    .brand { font-size: 21px; font-weight: 700; letter-spacing: -1px; }
    .brand span { color: var(--accent); }
    .subtle { color: var(--muted); font-size: 12px; }
    footer {
      border-top: 1px solid var(--border);
      padding: 24px 0;
      color: var(--muted);
      font-size: 12px;
    }
    .screen { display: none !important; }
    .screen.active { display: block !important; }
    h1, h2 { letter-spacing: -.05em; }
    .hero {
      min-height: 64vh;
      max-width: 680px;
      margin: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 80px 0;
    }
    .hero h1 {
      font-size: clamp(48px, 8vw, 76px);
      line-height: 1.08;
      margin: 18px 0;
    }
    .hero h1 span { color: var(--accent); }
    .hero p {
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 32px;
    }
    .eyebrow {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      color: var(--accent);
      text-transform: uppercase;
    }
    .primary {
      background: var(--accent);
      color: #171717;
      border: 0;
      border-radius: 10px;
      padding: 16px 24px;
      font-weight: 700;
    }
    .primary:hover { background: #f2d1ac; }
    .hero .primary { align-self: center; }

    /* Always-visible temperature control */
    .temperature {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #17181cf5;
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 16px 0;
    }
    .temperature-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
    }
    .temperature-title { font-size: 14px; font-weight: 700; }
    #temperatureDescription {
      font-size: 12px;
      color: var(--muted);
      margin-top: 5px;
    }
    .temperature-controls {
      display: flex;
      align-items: center;
      gap: 13px;
      flex: 1;
      max-width: 420px;
    }
    .temperature-controls span {
      white-space: nowrap;
      color: var(--muted);
      font-size: 12px;
    }
    input[type="range"] {
      width: 100%;
      accent-color: var(--accent);
      cursor: pointer;
    }

    /* Questions */
    .quiz {
      max-width: 740px;
      margin: auto;
      min-height: 68vh;
      padding: 35px 0 80px;
    }
    .quiz-top { display: flex; justify-content: space-between; }
    .back, .skip {
      background: transparent;
      border: 0;
      color: var(--muted);
      padding: 10px 0;
    }
    .progress {
      height: 4px;
      background: var(--border);
      border-radius: 5px;
      overflow: hidden;
      margin-top: 20px;
    }
    .progress-fill {
      height: 100%;
      width: 12.5%;
      background: var(--accent);
      transition: width .25s;
    }
    .question-main { padding-top: 60px; }
    .question-main h2 {
      font-size: clamp(36px, 6vw, 56px);
      line-height: 1.15;
      margin: 14px 0;
    }
    .helper { color: var(--muted); font-size: 14px; }
    .choices {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 34px;
    }
    .choice {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 12px;
      min-height: 145px;
      padding: 20px;
      text-align: left;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .choice:hover { border-color: var(--accent); }
    .choice .number { color: var(--muted); font-size: 12px; }
    .choice .answer { font-size: 21px; font-weight: 600; }
    .input-row { display: flex; gap: 12px; margin-top: 20px; }
    .custom-form {
      display: flex;
      flex: 1;
      min-width: 0;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .custom-form input {
      flex: 1;
      min-width: 0;
      background: none;
      border: 0;
      color: var(--text);
      padding: 15px;
      outline: none;
    }
    .custom-form button {
      background: none;
      border: 0;
      color: var(--accent);
      padding: 0 18px;
    }

    /* Results */
    .results { padding: 60px 0 90px; }
    .results-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 30px;
    }
    .results h2 { font-size: 48px; margin: 8px 0 0; }
    .secondary {
      background: none;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      padding: 13px 16px;
    }
    .movies {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    .movie { min-width: 0; }
    .poster {
      aspect-ratio: 4 / 4.5;
      border-radius: 11px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--poster-bg);
      overflow: hidden;
    }
    .poster-index { font-size: 11px; letter-spacing: .1em; }
    .poster-title {
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -.05em;
      line-height: 1.1;
    }
    .movie h3 { margin: 16px 0 5px; font-size: 18px; }
    .movie-meta { color: var(--muted); font-size: 12px; }
    .movie-reason {
      color: #c6c3c6;
      font-size: 13px;
      line-height: 1.6;
    }
    .results-actions { text-align: center; margin-top: 36px; }
    .demo-note {
      color: var(--muted);
      font-size: 11px;
      text-align: center;
      margin-top: 25px;
    }

    @media (max-width: 650px) {
      .shell { padding: 0 18px; }
      .temperature-inner { flex-direction: column; align-items: stretch; gap: 12px; }
      .temperature-controls { max-width: none; }
      .temperature-controls span { font-size: 11px; }
      .hero { min-height: 60vh; }
      .choices { grid-template-columns: 1fr; }
      .choice { min-height: 105px; padding: 15px; }
      .input-row { flex-wrap: wrap; }
      .custom-form { flex-basis: 100%; }
      .skip { margin: auto; }
      .movies { grid-template-columns: 1fr; gap: 30px; }
      .poster { aspect-ratio: 1.4; max-height: 280px; }
      .results-head h2 { font-size: 36px; }
      .results-head { align-items: flex-start; }
    }
  </style>
</head>
<body>
<div class="shell">
  <header>
    <div class="brand"><span>✳</span> movie buddy.</div>
    <div class="subtle">Find your movie</div>
  </header>
</div>

<div class="temperature">
  <div class="shell temperature-inner">
    <div>
      <div class="temperature-title">How adventurous are you feeling?</div>
      <div id="temperatureDescription">A little adventure, a little familiarity.</div>
    </div>
    <div class="temperature-controls">
      <span>Play it safe</span>
      <input id="temperatureSlider" type="range"
             min="0" max="2" step="0.1" value="0.7"
             aria-label="How adventurous are you feeling?">
      <span>Surprise me!</span>
    </div>
  </div>
</div>

<div class="shell">
  <main>
    <section id="landing" class="screen active hero">
      <div class="eyebrow">Movie night, made easy</div>
      <h1>Find something <span>great</span> to watch.</h1>
      <p>A few quick questions. Three movie picks made for you.</p>
      <button class="primary" id="startButton">Find my movie →</button>
    </section>

    <section id="quiz" class="screen quiz">
      <div class="quiz-top">
        <button class="back" id="backButton">← Back</button>
        <span class="subtle" id="questionCount">01 / 08</span>
      </div>
      <div class="progress">
        <div class="progress-fill" id="progressFill"></div>
      </div>
      <div class="question-main">
        <div class="eyebrow" id="questionCategory"></div>
        <h2 id="questionTitle"></h2>
        <p class="helper">Choose what feels right.</p>
        <div class="choices" id="choices"></div>
        <div class="input-row">
          <form class="custom-form" id="customForm">
            <input id="customInput" maxlength="350"
                   placeholder="Or type your own answer..."
                   aria-label="Your own answer" required>
            <button type="submit" aria-label="Submit answer">→</button>
          </form>
          <button class="skip" id="skipButton">Skip →</button>
        </div>
      </div>
    </section>

    <section id="results" class="screen results">
      <div class="results-head">
        <div>
          <div class="eyebrow">Picked for you</div>
          <h2>Your three movies.</h2>
        </div>
        <button class="secondary" id="restartButton">Start over</button>
      </div>
      <div class="movies" id="movieGrid"></div>
      <div class="results-actions">
        <button class="primary" id="moreButton">Another three ↻</button>
      </div>
      <p class="demo-note">Demo recommendations · AI integration coming next</p>
    </section>
  </main>
  <footer>
    <span>movie buddy © 2026</span>
    <span>Less scrolling. More watching.</span>
  </footer>
</div>

<script>
  const $ = id => document.getElementById(id);

  const questions = [
    { id:"mood", category:"MOOD",
      title:"How should tonight feel?",
      options:["Something comforting","Something intense"],
      values:["comfort","intense"] },
    { id:"pace", category:"PACE",
      title:"How should the story move?",
      options:["Slow and immersive","Fast and gripping"],
      values:["slow","fast"] },
    { id:"tone", category:"ATMOSPHERE",
      title:"Which mood pulls you in?",
      options:["Light and hopeful","Dark and mysterious"],
      values:["light","dark"] },
    { id:"story", category:"STORY",
      title:"What kind of world?",
      options:["Real human stories","Something imaginative"],
      values:["real","imaginative"] },
    { id:"feeling", category:"EXPERIENCE",
      title:"What should stay with you?",
      options:["A strong feeling","Something to think about"],
      values:["emotional","thoughtful"] },
    { id:"style", category:"STYLE",
      title:"How unusual should it be?",
      options:["Easy to follow","Bold and unexpected"],
      values:["accessible","experimental"] },
    { id:"era", category:"ERA",
      title:"Which would you prefer?",
      options:["Something recent","An older classic"],
      values:["modern","classic"] },
    { id:"energy", category:"ENERGY",
      title:"What sounds better?",
      options:["A gentle escape","An exciting ride"],
      values:["gentle","thrilling"] }
  ];

  // Small demonstration catalogue — replaced by TMDB later.
  const films = [
    { title:"Inception", year:2010, genre:"Sci-fi",
      tags:["intense","fast","dark","imaginative","thoughtful","modern","thrilling"],
      note:"An ambitious, mind-bending cinematic ride.",
      color:"linear-gradient(140deg,#243d4f,#526478,#1b1f31)" },
    { title:"Interstellar", year:2014, genre:"Sci-fi",
      tags:["intense","slow","light","imaginative","emotional","modern"],
      note:"An enormous journey with an emotional heart.",
      color:"linear-gradient(145deg,#516676,#9b9b99,#1c2733)" },
    { title:"Whiplash", year:2014, genre:"Drama",
      tags:["intense","fast","dark","real","emotional","modern","thrilling"],
      note:"A gripping story of ambition and obsession.",
      color:"linear-gradient(145deg,#a55b2e,#251920,#5b332e)" },
    { title:"Past Lives", year:2023, genre:"Romance",
      tags:["comfort","slow","light","real","emotional","modern"],
      note:"A tender story about love and possibility.",
      color:"linear-gradient(145deg,#455869,#be9478,#6a888e)" },
    { title:"Aftersun", year:2022, genre:"Drama",
      tags:["comfort","slow","dark","real","emotional","experimental","modern"],
      note:"Quiet, intimate and deeply moving.",
      color:"linear-gradient(155deg,#8d9e8b,#d1b48b,#2c5667)" },
    { title:"The Grand Budapest Hotel", year:2014, genre:"Comedy",
      tags:["comfort","fast","light","imaginative","experimental","modern"],
      note:"Playful, beautifully crafted and charming.",
      color:"linear-gradient(145deg,#8c637b,#e0a5a7,#724c65)" },
    { title:"Columbus", year:2017, genre:"Drama",
      tags:["comfort","slow","light","real","thoughtful","experimental"],
      note:"A quiet and thoughtful cinematic experience.",
      color:"linear-gradient(150deg,#94aba0,#526577,#c6b99d)" },
    { title:"The Lobster", year:2015, genre:"Comedy",
      tags:["intense","slow","dark","imaginative","thoughtful","experimental"],
      note:"An unusual and darkly funny story.",
      color:"linear-gradient(145deg,#6d858a,#253e46,#919d9b)" },
    { title:"Spirited Away", year:2001, genre:"Animation",
      tags:["comfort","light","imaginative","emotional","classic"],
      note:"A magical and unforgettable adventure.",
      color:"linear-gradient(155deg,#306b62,#b58a6c,#403d62)" },
    { title:"The Rider", year:2017, genre:"Western",
      tags:["comfort","slow","real","emotional","experimental"],
      note:"An intimate portrait of identity and resilience.",
      color:"linear-gradient(145deg,#cf9e69,#7a827c,#343949)" },
    { title:"The Dark Knight", year:2008, genre:"Action",
      tags:["intense","fast","dark","thoughtful","thrilling"],
      note:"An intense blockbuster with a compelling story.",
      color:"linear-gradient(135deg,#283444,#111e28,#6c6e71)" },
    { title:"Perfect Days", year:2023, genre:"Drama",
      tags:["comfort","slow","light","real","emotional","modern"],
      note:"Finding beauty in the simplest moments.",
      color:"linear-gradient(145deg,#3a624e,#b4a66e,#2b3a47)" }
  ];

  let history = [];
  let currentQuestion = null;
  let previouslyShown = new Set();

  const temperature = () => Number($("temperatureSlider").value);

  function showScreen(id) {
    document.querySelectorAll(".screen").forEach(screen => {
      screen.classList.toggle("active", screen.id === id);
    });
    window.scrollTo(0, 0);
  }

  function updateTemperature() {
    const t = temperature();
    $("temperatureDescription").textContent =
      t < .5 ? "Keeping it familiar." :
      t < 1.1 ? "A little adventure, a little familiarity." :
      t < 1.6 ? "Let's try something unexpected." :
                "Anything goes. Surprise me!";
  }

  function getProfile() {
    return Object.fromEntries(
      history.filter(x => x.value !== null)
             .map(x => [x.id, x.value])
    );
  }

  function chooseQuestion() {
    const profile = getProfile();
    const available = questions.filter(q =>
      !history.some(h => h.id === q.id)
    );

    const ranked = available.map(q => {
      let score = 10 - questions.indexOf(q);

      if (profile.mood === "intense" &&
          ["pace","tone","energy"].includes(q.id)) score += 12;
      if (profile.mood === "comfort" &&
          ["story","feeling","tone"].includes(q.id)) score += 12;
      if (profile.story === "imaginative" &&
          q.id === "style") score += 10;

      score += (Math.random() - .5) * temperature() * 14;
      return { q, score };
    });

    ranked.sort((a,b) => b.score - a.score);
    return ranked[0]?.q || null;
  }

  function renderQuestion() {
    const meaningful = history.filter(h => h.value !== null).length;

    if (history.length >= 8 || meaningful >= 6) {
      renderResults();
      return;
    }

    currentQuestion = chooseQuestion();
    if (!currentQuestion) {
      renderResults();
      return;
    }

    $("questionCount").textContent =
      String(history.length + 1).padStart(2,"0") + " / 08";

    $("progressFill").style.width =
      ((history.length + 1) / 8 * 100) + "%";

    $("questionCategory").textContent = currentQuestion.category;
    $("questionTitle").textContent = currentQuestion.title;
    $("customInput").value = "";

    $("choices").replaceChildren();

    currentQuestion.options.forEach((option,i) => {
      const button = document.createElement("button");
      button.className = "choice";

      const num = document.createElement("span");
      num.className = "number";
      num.textContent = "0" + (i+1) + " ↗";

      const text = document.createElement("span");
      text.className = "answer";
      text.textContent = option;

      button.append(num,text);
      button.onclick = () => submitAnswer(currentQuestion.values[i]);
      $("choices").append(button);
    });

    showScreen("quiz");
  }

  function submitAnswer(value) {
    history.push({ id:currentQuestion.id, value });
    renderQuestion();
  }

  function interpretText(text) {
    // Placeholder until GPT understands natural-language answers.
    const s = text.toLowerCase();
    const dictionary = {
      comfort:["comfort","funny","happy","cozy","relax"],
      intense:["intense","scary","horror","stress"],
      slow:["slow","quiet","calm"],
      fast:["fast","action","thrill"],
      dark:["dark","mystery","sad"],
      light:["bright","happy","uplift"],
      real:["real","human","family","true"],
      imaginative:["fantasy","magic","space","sci-fi"],
      emotional:["cry","love","heart","emotional"],
      thoughtful:["think","complex","philosophy"],
      experimental:["weird","unusual","art"],
      classic:["classic","old","vintage"]
    };

    let best = null, bestCount = 0;
    for (const [tag,words] of Object.entries(dictionary)) {
      const count = words.filter(w => s.includes(w)).length;
      if (count > bestCount) {
        best = tag;
        bestCount = count;
      }
    }
    return best || "custom:" + text.slice(0,120);
  }

  function rankMovies() {
    const preferences = history.map(h => h.value).filter(Boolean);

    return films.map(movie => {
      const matches = preferences.filter(v =>
        movie.tags.includes(v)
      ).length;

      let score = preferences.length
        ? matches / preferences.length
        : .5;

      if (previouslyShown.has(movie.title)) score -= .25;

      // Demonstrates variation; not a real LLM temperature.
      score += (Math.random() - .5) * temperature() * .4;

      return { ...movie, score };
    }).sort((a,b) => b.score - a.score);
  }

  function renderResults() {
    const ranked = rankMovies();
    const picks = [];

    for (const film of ranked) {
      if (picks.length >= 3) break;
      if (picks.some(x => x.genre === film.genre)) continue;
      picks.push(film);
    }
    for (const film of ranked) {
      if (picks.length >= 3) break;
      if (!picks.some(x => x.title === film.title)) picks.push(film);
    }

    $("movieGrid").replaceChildren();

    picks.forEach((film,i) => {
      previouslyShown.add(film.title);

      const card = document.createElement("article");
      card.className = "movie";

      const poster = document.createElement("div");
      poster.className = "poster";
      poster.style.setProperty("--poster-bg",film.color);

      const index = document.createElement("span");
      index.className = "poster-index";
      index.textContent = "MOVIE / 0" + (i+1);

      const posterTitle = document.createElement("span");
      posterTitle.className = "poster-title";
      posterTitle.textContent = film.title;
      poster.append(index,posterTitle);

      const title = document.createElement("h3");
      title.textContent = film.title;

      const meta = document.createElement("div");
      meta.className = "movie-meta";
      meta.textContent = film.year + " · " + film.genre;

      const reason = document.createElement("p");
      reason.className = "movie-reason";
      reason.textContent = film.note;

      card.append(poster,title,meta,reason);
      $("movieGrid").append(card);
    });

    showScreen("results");
  }

  function restart() {
    history = [];
    previouslyShown.clear();
    $("temperatureSlider").value = "0.7";
    updateTemperature();
    showScreen("landing");
  }

  $("startButton").onclick = renderQuestion;
  $("skipButton").onclick = () => submitAnswer(null);

  $("backButton").onclick = () => {
    if (history.length) {
      history.pop();
      renderQuestion();
    } else {
      showScreen("landing");
    }
  };

  $("customForm").onsubmit = e => {
    e.preventDefault();
    const text = $("customInput").value.trim();
    if (text) submitAnswer(interpretText(text));
  };

  $("restartButton").onclick = restart;
  $("moreButton").onclick = renderResults;

  $("temperatureSlider").addEventListener("input",updateTemperature);

  $("temperatureSlider").addEventListener("change",() => {
    if ($("results").classList.contains("active")) {
      previouslyShown.clear();
      renderResults();
    }
  });

  updateTemperature();
</script>
</body>
</html>
