</main><footer class="footer"><span>movie buddy</span><span>Less searching. More watching.</span></footer></div><script>
"use strict";
const el=id=>document.getElementById(id);
const questions=[
{id:"mood",label:"THE FEELING",question:"How should tonight feel?",answers:["Something comforting","Something intense"],values:["comfort","intense"]},
{id:"pace",label:"THE TEMPO",question:"What kind of pace feels right?",answers:["Take your time","Keep me on edge"],values:["slow","fast"]},
{id:"tone",label:"THE ATMOSPHERE",question:"Which atmosphere pulls you in?",answers:["Light & hopeful","Dark & mysterious"],values:["light","dark"]},
{id:"story",label:"THE STORY",question:"Where should the story take you?",answers:["Real lives, real feelings","Beyond the everyday"],values:["real","imaginative"]},
{id:"feeling",label:"THE AFTERTASTE",question:"What should stay with you?",answers:["An emotional feeling","A thought-provoking idea"],values:["emotional","thoughtful"]},
{id:"style",label:"THE CRAFT",question:"How should it tell its story?",answers:["Simple & immersive","Unexpected & unusual"],values:["accessible","experimental"]},
{id:"era",label:"THE ERA",question:"Which era calls to you?",answers:["Something recent","An older favourite"],values:["modern","classic"]},
{id:"energy",label:"THE LAST DETAIL",question:"What kind of ending to your night?",answers:["A gentle escape","A real adrenaline rush"],values:["gentle","thrilling"]}
];
const films=[
{title:"Inception",year:2010,genre:"Science fiction · Thriller",pop:96,tags:["intense","fast","dark","imaginative","thoughtful","accessible","modern","thrilling"],note:"Big-screen ambition and a puzzle that keeps unfolding.",color:"linear-gradient(140deg,#243d4f,#526478,#1b1f31)"},
{title:"Interstellar",year:2014,genre:"Science fiction · Drama",pop:97,tags:["intense","slow","light","imaginative","emotional","accessible","modern","thrilling"],note:"Vast, beautiful, and unexpectedly personal.",color:"linear-gradient(145deg,#516676,#9b9b99,#1c2733)"},
{title:"The Dark Knight",year:2008,genre:"Crime · Thriller",pop:96,tags:["intense","fast","dark","real","thoughtful","accessible","modern","thrilling"],note:"A sweeping, relentlessly tense modern classic.",color:"linear-gradient(135deg,#283444,#111e28,#6c6e71)"},
{title:"Spirited Away",year:2001,genre:"Animation · Fantasy",pop:89,tags:["comfort","fast","light","imaginative","emotional","experimental","classic","gentle"],note:"A magical world worth getting completely lost in.",color:"linear-gradient(155deg,#306b62,#b58a6c,#403d62)"},
{title:"The Shawshank Redemption",year:1994,genre:"Drama",pop:93,tags:["comfort","slow","light","real","emotional","accessible","classic","gentle"],note:"A hopeful story with enduring emotional force.",color:"linear-gradient(145deg,#88745e,#344655,#d2b58a)"},
{title:"Whiplash",year:2014,genre:"Drama · Music",pop:81,tags:["intense","fast","dark","real","emotional","accessible","modern","thrilling"],note:"Pure electricity between ambition and obsession.",color:"linear-gradient(145deg,#a55b2e,#251920,#5b332e)"},
{title:"Knives Out",year:2019,genre:"Mystery · Comedy",pop:82,tags:["comfort","fast","light","real","thoughtful","accessible","modern","thrilling"],note:"An effortlessly entertaining modern whodunit.",color:"linear-gradient(145deg,#7d4938,#c3a16a,#272f34)"},
{title:"The Grand Budapest Hotel",year:2014,genre:"Comedy · Adventure",pop:79,tags:["comfort","fast","light","imaginative","emotional","experimental","modern","gentle"],note:"Perfectly composed chaos with a bittersweet centre.",color:"linear-gradient(145deg,#8c637b,#e0a5a7,#724c65)"},
{title:"Past Lives",year:2023,genre:"Romance · Drama",pop:54,tags:["comfort","slow","light","real","emotional","accessible","modern","gentle"],note:"A quietly devastating story of timing and possibility.",color:"linear-gradient(145deg,#455869,#be9478,#6a888e)"},
{title:"Aftersun",year:2022,genre:"Drama",pop:47,tags:["comfort","slow","dark","real","emotional","experimental","modern","gentle"],note:"Tiny remembered moments with immense emotional weight.",color:"linear-gradient(155deg,#8d9e8b,#d1b48b,#2c5667)"},
{title:"The Lobster",year:2015,genre:"Drama · Dark comedy",pop:49,tags:["intense","slow","dark","imaginative","thoughtful","experimental","modern","gentle"],note:"A strange and funny look at belonging and love.",color:"linear-gradient(145deg,#6d858a,#253e46,#919d9b)"},
{title:"The Worst Person in the World",year:2021,genre:"Comedy · Drama",pop:46,tags:["comfort","fast","light","real","emotional","experimental","modern","gentle"],note:"Witty, messy and recognisably human.",color:"linear-gradient(150deg,#c4a58f,#678c96,#424861)"},
{title:"Columbus",year:2017,genre:"Drama",pop:22,tags:["comfort","slow","light","real","thoughtful","experimental","modern","gentle"],note:"A delicate film about space, purpose and connection.",color:"linear-gradient(150deg,#94aba0,#526577,#c6b99d)"},
{title:"The Rider",year:2017,genre:"Drama · Western",pop:18,tags:["comfort","slow","light","real","emotional","experimental","modern","gentle"],note:"A tender portrait of identity and resilience.",color:"linear-gradient(145deg,#cf9e69,#7a827c,#343949)"},
{title:"The Vast of Night",year:2019,genre:"Mystery · Science fiction",pop:24,tags:["intense","fast","dark","imaginative","thoughtful","experimental","modern","thrilling"],note:"A low-key, hypnotic mystery full of curiosity.",color:"linear-gradient(145deg,#273c5c,#866c82,#161b32)"},
{title:"The Fits",year:2015,genre:"Drama",pop:10,tags:["intense","slow","dark","real","thoughtful","experimental","modern","gentle"],note:"An enigmatic coming-of-age film unlike the usual.",color:"linear-gradient(145deg,#395978,#78628d,#2c263d)"},
{title:"The Turin Horse",year:2011,genre:"Drama",pop:8,tags:["intense","slow","dark","real","thoughtful","experimental","classic","gentle"],note:"Rigorous and haunting, for an adventurous movie night.",color:"linear-gradient(145deg,#575659,#212329,#949190)"},
{title:"Paterson",year:2016,genre:"Comedy · Drama",pop:29,tags:["comfort","slow","light","real","emotional","experimental","modern","gentle"],note:"The extraordinary poetry of ordinary days.",color:"linear-gradient(145deg,#70847b,#c3a27c,#303e49)"},
{title:"Perfect Days",year:2023,genre:"Drama",pop:39,tags:["comfort","slow","light","real","emotional","experimental","modern","gentle"],note:"A warmly observant invitation to see everyday life anew.",color:"linear-gradient(145deg,#3a624e,#b4a66e,#2b3a47)"}
];
let history=[],current=null,previous=new Set();
function page(id){for(const s of document.querySelectorAll(".screen"))s.classList.toggle("active",s.id===id);el("headCaption").textContent=id==="landing"?"Find your movie":id==="questions"?"Your movie match":"Your picks";window.scrollTo({top:0,behavior:"instant"})}
function profile(){return Object.fromEntries(history.filter(x=>x.value!==null).map(x=>[x.id,x.value]))}
function relevance(q,p){let score=10-questions.indexOf(q);if(p.mood==="intense"&&["pace","tone","energy"].includes(q.id))score+=12;if(p.mood==="comfort"&&["story","feeling","tone"].includes(q.id))score+=12;if(p.story==="imaginative"&&q.id==="style")score+=10;if(p.pace==="slow"&&q.id==="feeling")score+=7;return score}
function pickQuestion(){const p=profile(),t=Number(el("temperature").value);let left=questions.filter(q=>!history.some(h=>h.id===q.id));let ranked=left.map(q=>({q,score:relevance(q,p)+((Math.random()-.5)*t*14)})).sort((a,b)=>b.score-a.score);return ranked[0]?.q||null}
function renderQuestion(){if(history.length>=8||history.filter(x=>x.value!==null).length>=6){renderFilms();return}
current=pickQuestion();if(!current){renderFilms();return}
el("counter").textContent=String(history.length+1).padStart(2,"0")+" / 08";
el("progress").style.width=((history.length+1)/8*100)+"%";
el("qCategory").textContent=current.label;el("qTitle").textContent=current.question;
el("customAnswer").value="";
el("answers").replaceChildren(...current.answers.map((a,i)=>{let b=document.createElement("button");b.className="choice";let top=document.createElement("div");top.className="choice-meta";top.innerHTML="<span>0"+(i+1)+"</span><span>↗</span>";let bottom=document.createElement("span");bottom.className="choice-title";bottom.textContent=a;b.append(top,bottom);b.onclick=()=>submit(current.values[i]);return b}));
page("questions")}
function submit(value){history.push({id:current.id,value});renderQuestion()}
function textValue(text){let s=text.toLowerCase(),tags={comfort:["comfort","funny","cozy","happy","relax","chill","feel good","romantic"],intense:["intense","scary","horror","suspense","stress","disturb"],slow:["slow","calm","quiet","meditat"],fast:["action","fast","quick","thrill"],dark:["dark","sad","grim","mystery"],light:["happy","bright","light","uplift"],real:["real","human","true","life","family"],imaginative:["fantasy","space","sci-fi","magic","surreal"],emotional:["cry","emotional","love","heart"],thoughtful:["think","philosoph","complex","brain"],experimental:["weird","art","avant","unusual"],accessible:["easy","simple","casual"],modern:["new","recent","modern"],classic:["old","classic","vintage"],gentle:["relax","gentle"],thrilling:["exciting","edge","adrenaline"]};let matches=Object.entries(tags).map(([k,v])=>({k,count:v.filter(w=>s.includes(w)).length})).sort((a,b)=>b.count-a.count);return matches[0].count?matches[0].k:"custom:"+text.slice(0,120)}
function rank(){const vals=history.map(h=>h.value).filter(Boolean);return films.map(f=>{const count=vals.filter(v=>f.tags.includes(v)).length;const fit=vals.length?count/vals.length:0.5;let score=fit;if(previous.has(f.title))score-=.22;score+=(Math.random()-.5)*Number(el("temperature").value)*.47;return {...f,score}}).sort((a,b)=>b.score-a.score)}
function renderFilms(){const ordered=rank(),selected=[];for(const movie of ordered){if(selected.length>=3)break;const mainGenre=movie.genre.split(" · ")[0];if(selected.some(m=>m.genre.split(" · ")[0]===mainGenre))continue;selected.push(movie)}for(const movie of ordered){if(selected.length===3)break;if(!selected.some(m=>m.title===movie.title))selected.push(movie)}selected.forEach(m=>previous.add(m.title));
el("resultGrid").replaceChildren(...selected.map((film,i)=>{const article=document.createElement("article");article.className="film";article.innerHTML='<div class="poster"><span class="poster-num"></span><div class="poster-title"></div></div><div class="film-details"><div class="film-eyebrow"></div><div class="film-title"></div><div class="film-meta"></div><p class="film-description"></p></div>';article.querySelector(".poster").style.setProperty("--film-bg",film.color);article.querySelector(".poster-num").textContent="MOVIE / 0"+(i+1);article.querySelector(".poster-title").textContent=film.title;article.querySelector(".film-eyebrow").textContent=["YOUR FIRST PICK","ANOTHER DIRECTION","THE WILD CARD"][i];article.querySelector(".film-title").textContent=film.title;article.querySelector(".film-meta").textContent=film.year+"  ·  "+film.genre;article.querySelector(".film-description").textContent=film.note;return article}));page("end")}
function reset(){history=[];previous.clear();el("temperature").value="0.7";setTemperature();page("landing")}
el("begin").onclick=()=>renderQuestion();el("skip").onclick=()=>submit(null);
el("goBack").onclick=()=>{if(history.length){history.pop();renderQuestion()}else page("landing")};
el("customForm").onsubmit=e=>{e.preventDefault();const s=el("customAnswer").value.trim();if(s)submit(textValue(s))};
el("startOver").onclick=reset;el("more").onclick=renderFilms;
function setTemperature(){const t=Number(el("temperature").value);el("tempExplain").textContent=t<0.5?"Keeping it familiar.":t<1.1?"A little adventure, a little familiarity.":t<1.6?"Let’s try something unexpected.":"Anything goes. Surprise me!";window.movieBuddyAISettings={model:"gpt-4o-mini",temperature:t};}
el("temperature").addEventListener("input",setTemperature);
el("temperature").addEventListener("change",()=>{if(el("end").classList.contains("active")){previous.clear();renderFilms();}});
setTemperature();
</script></body></html>
